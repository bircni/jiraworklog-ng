{
  "name": "jiraworklog-ng",
  "version": "0.1.0",
  "private": true,
  "author": "JiraWorklog",
  "main": "dist-electron/main.js",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "next dev -p 3877",
    "build": "next build",
    "start": "next start -p 3877",
    "lint": "eslint",
    "icons": "node scripts/gen-icons.mjs",
    "electron:compile": "tsc -p tsconfig.electron.json",
    "electron:dev:launch": "pnpm electron:compile && electron dist-electron/main.js",
    "electron:dev": "cross-env JWL_IPC_SECRET=dev-secret concurrently -k -n next,electron \"next dev -p 3877\" \"pnpm electron:dev:launch\"",
    "electron:build": "next build --webpack && node scripts/prepare-standalone.mjs && pnpm electron:compile && node scripts/rebuild-electron.mjs && electron-builder --win portable",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node scripts/db-sample.mjs seed",
    "db:unseed": "node scripts/db-sample.mjs clean",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit",
    "validate": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@react-pdf/renderer": "4.5.1",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.2",
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.10",
    "prebuild-install": "^7.1.3",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vitest": "4.1.10"
  },
  "build": {
    "appId": "com.jiraworklog.ng",
    "productName": "JiraWorklog",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "npmRebuild": false,
    "files": [
      "dist-electron/**/*",
      "!**/node_modules/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "standalone"
      },
      {
        "from": "drizzle",
        "to": "drizzle"
      },
      {
        "from": "assets",
        "to": "assets"
      }
    ],
    "win": {
      "target": "portable",
      "icon": "assets/icon.png"
    },
    "portable": {
      "artifactName": "JiraWorklog-${version}-portable.exe"
    }
  }
}
