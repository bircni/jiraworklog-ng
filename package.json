{
  "name": "jiraworklog-ng",
  "version": "0.1.0",
  "private": true,
  "author": "JiraWorklog",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "next dev -p 3877",
    "build": "next build",
    "start": "next start -p 3877",
    "lint": "eslint",
    "icons": "node scripts/gen-icons.mjs",
    "electron:compile": "tsc -p tsconfig.electron.json",
    "electron:dev:launch": "npm run electron:compile && electron dist-electron/main.js",
    "electron:dev": "cross-env JWL_IPC_SECRET=dev-secret concurrently -k -n next,electron \"next dev -p 3877\" \"npm run electron:dev:launch\"",
    "electron:build": "next build --webpack && node scripts/prepare-standalone.mjs && npm run electron:compile && node scripts/rebuild-electron.mjs && electron-builder --win portable",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node scripts/db-sample.mjs seed",
    "db:unseed": "node scripts/db-sample.mjs clean",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@react-pdf/renderer": "4.5.1",
    "better-sqlite3": "^12.10.0",
    "drizzle-orm": "^0.45.2",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.31.10",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prebuild-install": "^7.1.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.jiraworklog.ng",
    "productName": "JiraWorklog",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "npmRebuild": false,
    "files": [
      "dist-electron/**/*",
      "!**/node_modules/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "standalone"
      },
      {
        "from": "drizzle",
        "to": "drizzle"
      },
      {
        "from": "assets",
        "to": "assets"
      }
    ],
    "win": {
      "target": "portable",
      "icon": "assets/icon.png"
    },
    "portable": {
      "artifactName": "JiraWorklog-${version}-portable.exe"
    }
  }
}
